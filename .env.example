# Production deployments generate /opt/adwais/.env from GitHub environment
# secrets and variables. This file documents the resulting runtime values.

# Database configuration
DB_PASSWORD=development_password

# Webhook API keys
MOTASTIC_API_KEY=motastic_development_secret_key
NEWSLETTER_API_KEY=newsletter_development_secret_key

# OpenID Connect configuration
OIDC_AUTHORITY=https://your-idp.example.com
OIDC_AUDIENCE=adwais-api
OIDC_CLIENT_ID=adwais-frontend
OIDC_SCOPE=openid profile email
DEMO_MODE=false
SSO_BUTTON_LABEL=Sign in with SSO
SSO_BUTTON_LOGO_URL=

# Authentication secret for Kiosk JWT tokens
KIOSK_JWT_SECRET=SuperSecretKeyForTestingKioskTokens32CharsMinimum!

# Runtime configuration
ENABLE_RUNTIME_DATA_SEEDING=true
CLOUDFLARED_IMAGE_TAG=latest

# The production workflow sources this value from its encrypted GitHub secret.
CLOUDFLARE_TUNNEL_TOKEN=<your-cloudflare-tunnel-token>
