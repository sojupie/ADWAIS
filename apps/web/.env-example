# Local frontend configuration. Create apps/web/.env.local from this template.
# VITE_* values are public and are embedded into the browser bundle.
VITE_OIDC_AUTHORITY=
VITE_OIDC_CLIENT_ID=
VITE_OIDC_SCOPE=openid profile email
VITE_DEMO_MODE=false
VITE_SSO_BUTTON_LABEL=Sign in with SSO
VITE_SSO_BUTTON_LOGO_URL=
