# Optional local backend overrides.
# Normal development defaults live in Api/appsettings.Development.json.
# Copy this file to .env only when overriding those defaults.
# This file is committed. .env is not; it may contain secrets.

Authentication__OidcAuthority=https://your-idp.example.com
# Must equal the token's "aud" claim exactly. With Microsoft Entra and no
# custom Application ID URI, use the bare client ID (not "api://<client-id>").
Authentication__OidcAudience=adwais-api
Authentication__EnableDemoAccess=false

# Optional kiosk JWT overrides
# Authentication__KioskJwtSecret=<secret, at least 32 chars>
# Authentication__KioskJwtIssuer=ADWAIS
# Authentication__KioskJwtAudience=ADWAIS-Kiosk

# Set RESEED=true for one startup to replace existing demo orders,
# negative-ID monitors, and legacy [MOCK] tenants. Remove it afterwards.
# RESEED=true
