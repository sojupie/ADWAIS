# Copy this file to .env and fill in real values.
# This file is committed. .env is NOT — it contains real secrets.

# Optional deployment credentials for pulling the private API image from GHCR.
# Use a read-only token with the read:packages scope.
GHCR_PULL_USERNAME=<your-github-username>
GHCR_PULL_TOKEN=<your-read-packages-token>

# Database configuration
DB_PASSWORD=development_password

# Dashboard authentication
DASHBOARD_USER=admin
DASHBOARD_PASS=admin

# Webhook API keys
MOTASTIC_API_KEY=motastic_development_secret_key
NEWSLETTER_API_KEY=newsletter_development_secret_key

# Azure AD configuration
AZURE_TENANT_ID=<your-azure-tenant-id>
AZURE_CLIENT_ID=<your-azure-client-id>

# Authentication secret for Kiosk JWT tokens
KIOSK_JWT_SECRET=SuperSecretKeyForTestingKioskTokens32CharsMinimum!
